# Copy to .env and fill in. .env is gitignored; never commit real values.
# docker compose reads .env automatically; for the backend, export it into your shell:
#   set -a && . ./.env && set +a

# PostgreSQL (docker-compose.yml creates the database "engplat" with these credentials)
DB_URL=jdbc:postgresql://localhost:5432/engplat
DB_USER=engplat
DB_PASSWORD=change-me

# Anthropic API key for the Refactorer. Optional: without it the app still starts
# and /api/refactor returns 503.
ANTHROPIC_API_KEY=

# Time zone that defines "today" for review limits and stats (IANA name).
APP_TIMEZONE=America/Mexico_City
